#!/usr/bin/env bash
# Blocks commits that stage secrets: files that should never be tracked
# (matched by name, so `git add -f` can't sneak them in), then a gitleaks
# scan of the staged content.
#
# Enable once per clone (local config, not tracked):
#   git config core.hooksPath .githooks
set -euo pipefail

blocked=()
while IFS= read -r -d '' path; do
  case "${path##*/}" in
    *.ovpn | rclone.conf | *.kdbx | *.pem | *.key | *.p12 | *.pfx | .env | .env.* | \
      id_rsa | id_ecdsa | id_ed25519)
      blocked+=("$path")
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if ((${#blocked[@]})); then
  echo "pre-commit: refusing to commit files that hold secrets:" >&2
  printf '  %s\n' "${blocked[@]}" >&2
  echo "Unstage them with: git restore --staged <file>" >&2
  exit 1
fi

# gitleaks comes from home/git.nix; fall back to nixpkgs until that's built.
if command -v gitleaks >/dev/null; then
  gitleaks=(gitleaks)
else
  gitleaks=(nix run nixpkgs#gitleaks --)
fi
"${gitleaks[@]}" git --pre-commit --staged --redact --no-banner -v .
